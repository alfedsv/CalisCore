            "value" : "Приседания «пистолетик»"
          }
        }
      }
    },
    "workout.name.plank" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plank (classic on forearms)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планка (классическая на предплечьях)"
          }
        }
      }
    },
    "workout.name.pushup" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
