            "value" : "Jump push-ups / Explosive push-ups"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прыжковые отжимания / Взрывные отжимания"
          }
        }
      }
    },
    "workout.name.jumping_jacks" : {
      "extractionState" : "manual",
      "localizations" : {
