          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прыжки с разведением рук и ног"
          }
        }
      }
    },
    "workout.name.pike" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pike walk"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ходьба в позе «пика»"
          }
        }
      }
    },
    "workout.name.pistol" : {
